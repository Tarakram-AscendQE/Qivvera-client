# Names only; configure secret values outside source control. No default login exists.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
QIVVERA_LOCAL_SQLITE=true
QIVVERA_MIGRATE_LOCAL=true
DATABASE_PATH=data/qivvera.sqlite
# Set a JSON array of named accounts with email, passwordHash and roles in secret settings.
QIVVERA_ACCOUNTS_JSON=
QIVVERA_REVIEW_MODE=independent
# Hosted: NODE_ENV=production, PUBLIC_ORIGIN=https://exact-approved-host,
# DATABASE_URL=<secret>, DATABASE_SSL_MODE=verify-full; run npm run migrate first.
# Optional OWNER_EMAIL + OWNER_PASSWORD_HASH supports one owner without default credentials.
# OWNER_PASSWORD is accepted only with a random 32-hex OWNER_PASSWORD_SALT provisioned once.
# Default independent mode needs a separate authorized reviewer identity for acceptance.
