# Names only; configure secret values outside source control. No default login exists.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
# PostgreSQL is the only database. Leave DATABASE_URL unset and `npm run dev` starts a temporary local
# PostgreSQL in Docker (its data is removed when you stop). To keep data, run your own and set:
# DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/<database>
# DATABASE_SSL_MODE=disable        (allowed only for a database on this machine)
QIVVERA_MIGRATE_LOCAL=true
# Sign-in uses the database account table (schema 8); manage it with `npm run accounts -- help`.
# Optional: a JSON array of named accounts (email, passwordHash, roles). A local (not hosted) run copies
# it into an EMPTY account table once; hosted runtimes ignore it. See docs/accounts.md.
# Simplest local sign-in (Author + Policy Authority): OWNER_EMAIL, OWNER_PASSWORD (16+ characters) and
# OWNER_PASSWORD_SALT (32 random hex characters, for example from `openssl rand -hex 16`).
QIVVERA_ACCOUNTS_JSON=
QIVVERA_REVIEW_MODE=independent
# Hosted: NODE_ENV=production, PUBLIC_ORIGIN=https://exact-approved-host,
# DATABASE_URL=<secret>, DATABASE_SSL_MODE=verify-full; run npm run migrate first.
# Optional OWNER_EMAIL + OWNER_PASSWORD_HASH supports one owner without default credentials.
# OWNER_PASSWORD is accepted only with a random 32-hex OWNER_PASSWORD_SALT provisioned once.
# Default independent mode needs a separate authorized reviewer identity for acceptance.

# Increment 3 is off until the operator has migrated schema 3 and configured a worker/test target.
QIVVERA_ASSURANCE_ENABLED=false
QIVVERA_TARGETS_JSON=[]
# Worker-only configuration (never provision target tokens into the frontend or Git):
# ASSURANCE_DATABASE_URL=<secret for restricted worker database role>
# QIVVERA_WORKER_ID=<named-worker>
# APPROVAL_TEST_REQUESTER_TOKEN=<worker-only target credential>
# APPROVAL_TEST_APPROVER_TOKEN=<worker-only target credential>
# QIVVERA_ALLOW_LOOPBACK_TARGETS=true is LOCAL-TEST ONLY; forbidden in hosted mode.

# Enable after migration 004; requires QIVVERA_ASSURANCE_ENABLED=true.
QIVVERA_RESOLUTION_ENABLED=false

# Increment 5: enable after schema 005 and review checks. Secrets belong only in secret settings.
QIVVERA_GENERALIZATION_ENABLED=false
QIVVERA_GITHUB_INTAKE_ENABLED=false
QIVVERA_GITHUB_REPOSITORIES_JSON=[]
# Example catalogue field tokenEnv names a separately provided read-only GitHub token.

# Increment 7: enable source-grounded drafting after schema 006 and reviewed runtime grants.
QIVVERA_DRAFTING_ENABLED=false
QIVVERA_DRAFTING_OPENAI_ENABLED=false
# Optional AI mode requires both protected settings; no default model or key is supplied.
# QIVVERA_DRAFTING_OPENAI_MODEL=<operator-approved model supporting Responses structured outputs>
# QIVVERA_DRAFTING_OPENAI_API_KEY=<separately provisioned provider secret, web runtime only>
# Each AI request additionally requires the Author's explicit source-processing confirmation.

# Increment 9: enable immutable verification templates only after schema 007 and reviewed grants.
# Requires QIVVERA_ASSURANCE_ENABLED=true and QIVVERA_GENERALIZATION_ENABLED=true.
# Templates do not transfer authority/evidence or start an assessment.
QIVVERA_TEMPLATES_ENABLED=false
