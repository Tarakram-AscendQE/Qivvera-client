{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{frontend/public/**,backend/migrations/**,backend/verifiers/**,backend/server/assurance/**,backend/server/resolution/**,backend/server/drafting/**,backend/server/impact/**,backend/server/templates/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/api",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/readyz",
      "destination": "/api/index.mjs"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "increments": false,
      "increment2": false,
      "increment3": true,
      "increment4": false,
      "increment5": false,
      "increment6": false,
      "increment7": false,
      "increment8": false,
      "increment9": false,
      "increment10": false,
      "tarak-local": false
    }
  }
}
