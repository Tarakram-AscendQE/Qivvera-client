{
  "name": "qivvera-foundation",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Qivvera independent change assurance with verified integrity and operational checks",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/sync-assets.mjs",
    "check": "node scripts/check-syntax.mjs && npm run typecheck && npm test",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:postgres": "REQUIRE_POSTGRES=true node --test --test-concurrency=1 test/workflow-postgres.test.mjs test/assurance-postgres.test.mjs test/resolution-postgres.test.mjs test/generalization-postgres.test.mjs test/drafting-postgres.test.mjs test/impact-postgres.test.mjs test/templates-postgres.test.mjs test/operations-postgres.test.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "start": "node backend/server/start.mjs",
    "start:registry": "node backend/server/start.mjs",
    "migrate": "node backend/scripts/migrate.mjs",
    "accounts": "node backend/scripts/accounts.mjs",
    "accounts:local": "node --env-file=.env.local backend/scripts/accounts.mjs",
    "check:release": "node scripts/verify-release.mjs",
    "check:engineering": "node scripts/verify-engineering.mjs",
    "audit:permissions": "node backend/scripts/audit-permissions.mjs",
    "rehearse:recovery": "node backend/scripts/rehearse-recovery.mjs",
    "selfcheck": "node scripts/selfcheck.mjs",
    "worker:once": "node backend/scripts/assurance-worker.mjs --once",
    "demo:assurance": "node scripts/reference-assurance.mjs",
    "test:assurance": "node --test test/assurance*.test.mjs",
    "worker:run": "node backend/scripts/assurance-worker.mjs --poll",
    "test:resolution": "node --test --test-concurrency=1 test/resolution*.test.mjs",
    "demo:resolution": "node scripts/reference-resolution.mjs",
    "demo:generalization": "node scripts/reference-generalization.mjs",
    "test:browser": "python3 test/run-browser-suites.py",
    "test:drafting": "node --test --test-concurrency=1 test/drafting*.test.mjs",
    "test:impact": "node --test --test-concurrency=1 test/impact*.test.mjs",
    "test:templates": "node --test --test-concurrency=1 test/templates*.test.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
