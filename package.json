{
  "name": "qivvera-foundation",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Qivvera obligation review and change revision increment",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/sync-assets.mjs",
    "check": "node scripts/check-syntax.mjs && npm run typecheck && npm test",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:postgres": "REQUIRE_POSTGRES=true node --test test/workflow-postgres.test.mjs",
    "start": "node server/start.mjs",
    "start:registry": "node server/start.mjs",
    "migrate": "node scripts/migrate.mjs",
    "check:release": "node scripts/verify-release.mjs",
    "selfcheck": "node scripts/selfcheck.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
