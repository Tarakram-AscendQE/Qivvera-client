{
  "name": "qivvera-foundation",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Qivvera finding resolution, correction lineage and evidence-backed reassessment",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/sync-assets.mjs",
    "check": "node scripts/check-syntax.mjs && npm run typecheck && npm test",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:postgres": "REQUIRE_POSTGRES=true node --test --test-concurrency=1 test/workflow-postgres.test.mjs test/assurance-postgres.test.mjs test/resolution-postgres.test.mjs",
    "start": "node server/start.mjs",
    "start:registry": "node server/start.mjs",
    "migrate": "node scripts/migrate.mjs",
    "check:release": "node scripts/verify-release.mjs",
    "selfcheck": "node scripts/selfcheck.mjs",
    "worker:once": "node scripts/assurance-worker.mjs --once",
    "demo:assurance": "node scripts/reference-assurance.mjs",
    "test:assurance": "node --test test/assurance*.test.mjs",
    "worker:run": "node scripts/assurance-worker.mjs --poll",
    "test:resolution": "node --test --test-concurrency=1 test/resolution*.test.mjs",
    "demo:resolution": "node scripts/reference-resolution.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
